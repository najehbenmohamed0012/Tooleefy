{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/**"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.js"
    },
    {
      "src": "^/(tools/invoice|tools/qr|tools/barcode|tools/converter|categories|blog.*|about|faq|contact|value-our-tools|privacy|terms|cookies|dashboard|admin|settings|login|register)/?$",
      "dest": "api/index.js"
    },
    {
      "src": "^/$",
      "dest": "api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.js"
    }
  ]
}
